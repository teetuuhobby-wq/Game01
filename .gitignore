# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — API keys live in environment variables, never here
.env
.env.*

# Godot
.godot/
.import/

# Web builds / node
node_modules/
dist/
build/

# Auto-generated screenshots (re-rendered often). Copy keepers to docs/screens/ instead.
shots/

# Playtest recordings (big, and only useful on the machine they were made on)
playtests/

# Big files from outside, exactly as they came (see README, "Folders"): sound downloads,
# asset packs, the user's reference images. The game uses small copies made from them.
originals/

# Builds to share (tools/export_build.ps1)
builds/

